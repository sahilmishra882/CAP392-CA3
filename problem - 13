class Solution {
    public int romanToInt(String s) {
        int total = 0;

        for (int i = 0; i < s.length(); i++) {
            int value = 0;

            char c = s.charAt(i);

            if (c == 'I') value = 1;
            else if (c == 'V') value = 5;
            else if (c == 'X') value = 10;
            else if (c == 'L') value = 50;
            else if (c == 'C') value = 100;
            else if (c == 'D') value = 500;
            else if (c == 'M') value = 1000;

            if (i + 1 < s.length()) {
                char next = s.charAt(i + 1);

                int nextValue = 0;
                if (next == 'I') nextValue = 1;
                else if (next == 'V') nextValue = 5;
                else if (next == 'X') nextValue = 10;
                else if (next == 'L') nextValue = 50;
                else if (next == 'C') nextValue = 100;
                else if (next == 'D') nextValue = 500;
                else if (next == 'M') nextValue = 1000;

                if (value < nextValue) {
                    total = total - value;
                } else {
                    total = total + value;
                }
            } else {
                total = total + value;
            }
        }

        return total;
    }
}
